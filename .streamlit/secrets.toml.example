# Copy to .streamlit/secrets.toml and fill in. Do NOT commit the real secrets.toml.
# Local development works without this file (dev defaults in config.py are used).

ANNOTATOR_PASSWORD = "change-me-annotator"
ADMIN_PASSWORD = "change-me-admin"

# Leave DATABASE_URL unset for local SQLite. For Supabase, paste the Postgres connection string,
# e.g. "postgresql+psycopg2://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"
# DATABASE_URL = ""

# Optional: override items per annotator (defaults to 50)
# PAIRS_PER_ANNOTATOR = "50"
